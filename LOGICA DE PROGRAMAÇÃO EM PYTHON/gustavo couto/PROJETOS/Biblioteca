import tkinter as tk
from tkinter import messagebox

def validar():
    nome = txt_nome.get()
    dias = txt_dias.get()

    if nome == "" or dias == "":
        messagebox.showwarning("Aviso", "Preencha todos os campos!")
        return
    
    dias = int(dias)

    if categoria.get() == "Raro" and usuario.get() == 2:
        messagebox.showwarning(
            "Empréstimo Negado",
            "Livros raros podem ser emprestados apenas para alunos."
        )
        return

    if usuario.get() == 1:
        limite = 14
        tipo = "Aluno"
    else:
        limite = 7
        tipo = "Comunidade"

    if dias <= limite:
        messagebox.showinfo(
            "Empréstimo Aprovado",
            f"Usuário: {nome}\n"
            f"Tipo: {tipo}\n"
            f"Categoria: {categoria.get()}\n"
            f"Prazo: {dias} dias"
        )
    else:
        multa = (dias - limite) * 5
        messagebox.showwarning(
            "Empréstimo Não Aprovado",
            f"Limite para {tipo}: {limite} dias\n"
            f"Excedeu em {dias - limite} dias\n"
            f"Taxa extra: R$ {multa:.2f}"
        )
        
