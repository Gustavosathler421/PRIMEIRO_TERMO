# Projeto 1:
# Projeto: Precisamos de um algoritmo para gerenciamento de cancelas para um shopping.
# Toda entrada e saída irá ser sinalizada
# Valores para entrada e permanência do veículo deverá ser pergutado 
# As entrada deverão ser registradas por placa.
# 
# Passo 1:  
# Perguntar informações sobre o veiculo ou forma acesso
# Pressionar o botao para emitir ticket
# Verificar se possui TAG para acesso liberado 
# Se possuir erros informar ao usuario

# Passo 2:
# Verificar tempo de permanencia
# Valor a ser cobrado

# Passo 3:
# Saida como sera?
# Calcular tempo de permanencia
# Se for tag gerar na fatura da tag
# Pagar ticket
# Devolver ticket na saida

# Passo 4:
# Gerar relatorio de entradas e saidas
# Tratamento de Erros
# Revisão do código

import datetime
import math
registro_veiculos = {} 
tags_cadastradas = ["TAG123", "TAG456"] 
relatorio = []
VALOR_FIXO_ENTRADA = 5.00 
VALOR_POR_HORA = 8.00      
def registrar_entrada():
    print("\n--- [ENTRADA] ---")
    placa = input("Digite a placa do veículo: ").upper()
    tem_tag = input("Possui TAG? (s/n): ").lower() == 's'
    tag_id = ""
    if tem_tag:
        tag_id = input("Digite o código da TAG: ").upper()
        if tag_id not in tags_cadastradas:
            print("❌ Erro: TAG inválida ou bloqueada.")
            tem_tag = False
            print("Procedendo como ticket manual.")
    hora_entrada = datetime.datetime.now()
    registro_veiculos[placa] = {
        'entrada': hora_entrada,
        'tag': tem_tag,
        'tag_id': tag_id
    }
    
    relatorio.append(f"ENTRADA | Placa: {placa} | Hora: {hora_entrada.strftime('%H:%M:%S')}")
    
    print(f"✅ Ticket emitido/Entrada registrada para {placa}")
    print(f"Hora: {hora_entrada.strftime('%H:%M:%S')}")

def registrar_saida():
    print("\n--- [SAÍDA] ---")
    placa = input("Digite a placa do veículo para saída: ").upper()
    
    if placa not in registro_veiculos:
        print(" Erro: Veículo não encontrado na entrada.")
        return

    dados = registro_veiculos[placa]
    hora_entrada = dados['entrada']
    hora_saida = datetime.datetime.now()
    duracao = hora_saida - hora_entrada
    total_minutos = duracao.total_seconds() / 60

    if total_minutos <= 60:
        valor_final = VALOR_FIXO_ENTRADA
    else:
        # Arredonda para cima as horas extras
        horas_extras = math.ceil((total_minutos - 60) / 60)
        valor_final = VALOR_FIXO_ENTRADA + (horas_extras * VALOR_POR_HORA)
    
    print(f"⏱️ Tempo de permanência: {int(total_minutos)} minutos")
    
    # Forma de Pagamento
    if dados['tag']:
        print(f"✅ TAG {dados['tag_id']} detectada. Valor de R$ {valor_final:.2f} lançado na fatura.")
    else:
        print(f"💰 Valor a pagar: R$ {valor_final:.2f}")
        input("Pressione Enter para confirmar pagamento...")
        print("✅ Pagamento confirmado.")
        print("🎫 Ticket devolvido.")

    # Finalização
    print("🚗 Cancela liberada.")
    del registro_veiculos[placa] 
    relatorio.append(f"SAÍDA   | Placa: {placa} | Valor: R$ {valor_final:.2f} | Permanência: {int(total_minutos)} min")

def gerar_relatorio():
    print("\n--- [RELATÓRIO DE MOVIMENTAÇÃO] ---")
    for registro in relatorio:
        print(registro)
    print("-----------------------------------")
def menu():
    while True:
        print("\n=== SISTEMA DE CANCELA SHOPPING ===")
        print("1. Registrar Entrada")
        print("2. Registrar Saída")
        print("3. Gerar Relatório")
        print("4. Sair")
        opcao = input("Escolha uma opção: ")
        
        if opcao == '1':
            registrar_entrada()
        elif opcao == '2':
            registrar_saida()
        elif opcao == '3':
            gerar_relatorio()
        elif opcao == '4':
            break
        else:
            print("Opção inválida.")
if __name__ == "__main__":
    menu()



    
